# ==============================================================================
# SwipeCHA + Hindsight Memory Configuration
# ==============================================================================

# Hindsight Memory Service
# Point to your local Hindsight server or Hindsight Cloud endpoint
HINDSIGHT_API_URL=http://127.0.0.1:8888
# HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=swipecha-security-bank
HINDSIGHT_TIMEOUT=2.0
HINDSIGHT_MAX_TOKENS=2048

# Memory and Agent Feature Flags
ENABLE_MEMORY=true
ENABLE_SECURITY_AGENT=true

# Security Agent LLM Configuration (Optional)
# If not configured, the Security Agent uses deterministic behavioral heuristic reasoning.
SECURITY_AGENT_PROVIDER=heuristic # "openai", "gemini", or "heuristic"
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
SECURITY_AGENT_MODEL=gpt-4o-mini
SECURITY_AGENT_TIMEOUT=2.0

# Challenge and Model Settings
CHALLENGE_TIMEOUT_SECONDS=300

# CORS Allowed Origins (comma-separated list of allowed origins, or '*' for local development)
# In production, set to your frontend domain: e.g. https://mycaptcha-site.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=*

